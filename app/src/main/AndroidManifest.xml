<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The day's reminder (ReminderAlarm), and only when the person turns
         it on in Settings -> Reminders: a notification, asked for there;
         and setting the next one again after the phone restarts, which
         clears every app's alarms. Neither reaches anything but the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoteOrganizer">
        <!-- configChanges: the phone turning, going dark, growing its
             letters or making them bold, changing its language or
             splitting its screen is drawn again by Compose, not answered
             by destroying the Activity. All of the app's state lives in
             that Activity, so rebuilding it dropped the person out of the
             note they were writing and back onto the list - found on the
             emulator, with a note open; bold letters and the language
             were missing from the list until the final audit. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NoteOrganizer"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share -> Note Organizer" from WhatsApp, email, anything
                 that sends text: a share code arrives in the import panel. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Lets another app open ONE attached file the person tapped, by a
             temporary grant, while the notebook stays private. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The reminder's alarm, and the phone's restart and the app's
             update, after which the next one is set again. Not exported:
             only the system and the app's own alarm reach it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The WebView a note is printed to PDF with may send Google usage
             statistics, when the person has allowed them for the phone.
             The privacy policy says the app sends nothing, so its WebView
             is opted out. -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />
    </application>

</manifest>